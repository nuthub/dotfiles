// -*- mode: js; -*-

{
    "ipc": true,
    "height": 36, // Waybar height (to be removed for auto height)
    "spacing": 8,// Gaps between modules (default: 4)
    // "layer": "top", // Waybar at top layer
    "position": "top", // Waybar position (top|bottom|left|right)
    // "width": 1280, // Waybar width
    "reload_style_on_change": true,
    // Choose the order of the modules
    "modules-left": ["sway/workspaces", "sway/mode", "sway/scratchpad", "sway/window"],
    // "modules-left": ["niri/workspaces", "niri/window"],
    "modules-center": [],
    "modules-right": ["network", "battery", "temperature", "power-profiles-daemon","wireplumber", "user", "custom/pomodoro", "tray", "custom/doorstatus", "group/display", "idle_inhibitor", "privacy", "custom/dunst", "clock"],

    // "custom/connections", 
    
    "group/display": {
	"orientation": "inherit",
	"drawer": {
            //"transition-duration": 500,
	    //            "children-class": "not-power",
	    "transition-left-to-right": false,
	},
	"modules": [
	    "custom/displays",
	    "backlight",
	    "custom/screenshot",
	    "custom/modeswitch",
	    "custom/wlsunset"
	]
    },

    "power-profiles-daemon": {
	"format": "{icon}",
	"tooltip-format": "Power profile: {profile}\nDriver: {driver}",
	"tooltip": true,
	"format-icons": {
	    "default": "",
	    "performance": "<span color=\"#FF9999\"></span>",
	    "balanced": "",
	    "power-saver": "<span color=\"#99FFFF\"></span>"
	}
    },

    "custom/connections": {
	"on-click": "alacritty -e nmtui",
	"exec": "~/.config/waybar/get_connections.sh",
	"interval": 10,
	"format" : "{icon} {text}",
	"format-icons": ""
    },

    "custom/doorstatus": {
	"on-click" : "~/.local/bin/doorstatus.sh",
	"exec": "~/.local/bin/doorstatus.sh",
	"class": "custom-doorstatus",
	"interval": 60
    },

    "custom/pomodoro": {
	"exec" : "org-pomodoro-state.sh",
	"return-type" : "json",
	"interval" : 1,
	"format" : "🍅 {}",
	"hide-empty-text" : true,
	"on-click" : "emacsclient -nc -e '(org-clock-goto)'",
	"class" : "custom-pomodoro"
    },

    "custom/dunst": {
	"exec" : "case $(dunstctl is-paused) in \"false\") echo \"\";; \"true\") echo \"\";; esac",
	"interval" : 10,
	"tooltip": true,
	"tooltip-format": "L: Pause / Resume\nR: Show history",
	"on-click": "dunstctl set-paused toggle && notify-send -h string:x-dunst-stack-tag:dunst-dnd \" Notifications enabled.\"",
	"on-click-right": "rofi-dunst-history.sh",
    },

    "custom/displays": {
	"on-click": "wdisplays",
	"format": "󰍹",
	"tooltip-format": "L: Launch WDisplay"
    },
    
    "custom/screenshot": {
	"on-click"  : "screenshot.sh -r",
	"on-click-right" : "emacsclient -nc ~/Pictures/Screenshots",
	"tooltip" : true,
	"tooltip-format" : "L: Take Screenshot\nR: Show Folder",
	"format" : "{icon}",
	"format-icons": ""
    },

    "custom/modeswitch": {
	"format" : "",
	"on-click": "darkman toggle",
	"tooltip-format": "L: Switch Dark / Light Mode"
    },

    "custom/wlsunset": {
	// adapted from https://github.com/Alexays/Waybar/issues/4328#issuecomment-3172305288
	"interval": "once",
        "tooltip": true,
        "return-type": "json",
        "format": "{icon}",
        "format-icons": {
            "on": "",
            "off": ""
        },
	"exec": "~/.config/waybar/sunset.sh",
        "on-click": "~/.config/waybar/sunset.sh toggle",
        //"exec-if": "~/.config/waybar/sunset.sh check",
        // "signal": 6	
    },
    
    // "custom/khal": {
    // 	"format": "{}",
    // 	"return-type": "json",
    // 	"interval": 10,
    // 	"exec": "~/.config/waybar/waybar-khal.py",
    // 	"on-click": "swaymsg workspace \"2: \"",
    // 	// "menu": "on-click-right",
    // 	// "menu-file": "khal-menu.xml",
    // 	// "menu-actions": {
    // 	//     "khal": "alacritty -e khal interactive",
    // 	//     "cloud": "swaymsg workspace \"2: \""
    // 	// }
    // },
    
    "tray": {
	"icon-size": 24,
	"spacing": 4,
	"show-passive-items": true
    },
    
    "clock": {
	"timezone": "Europe/Berlin",
	"locale": "de_DE.utf8",
	"format": "W{:%OV %d.%m. %H:%M}", //  
	// ugly hack because of https://github.com/Alexays/Waybar/issues/2240#issuecomment-2064237563
	// Example:            10 11 12 13 14 15 16 W00   10 11 12 13 14 15 16 W00   10 11 12 13 14 15 16 W00 
	"tooltip-format": "<tt>                                                                              \n{calendar}</tt>",
	"calendar" : {
	    "mode": "year",
	    "weeks-pos": "left",
	    "mode-mon-col": 3, // https://github.com/Alexays/Waybar/issues/2240
	    "format": {
		"months":     "<span color='#ffead3'><b>{}</b></span>",
		"days":       "<span color='#dddddd'><b>{}</b></span>",
		"weeks":      "<span color='#11BB11'>W{:%OV}</span>",
		"weekdays":   "<span color='#ffcc66'><b>{}</b></span>",
		"today":      "<span color='#ff6699'><b><u>{}</u></b></span>"
	    }
	},
	"on-click" : "swaymsg workspace \"2: \""
    },

    "cpu": {
	"format": " {usage}% {icon}",
	"format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"],
	"tooltip": true,
	"on-click": "alacritty -e htop"
    },

    "memory": {
	"format": " {}% {icon}",
	"format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"],
    },

    "temperature": {
	// "thermal-zone": 2,
	"critical-threshold": 95,
	"format": "{icon} {temperatureC}°C",
	"format-icons": ["", "", ""]
    },

    "backlight": {
	"device": "intel_backlight",
	"format": "{icon} {percent}%",
	"format-icons": ["", ""]
    },

    "network": {
	"interval": 2,
	"tooltip-format": "{ifname} ↑{bandwidthUpBytes} ↓{bandwidthDownBytes}",
	"format": " {ifname} {essid}",
	"format-disconnected": "",
	"on-click": "alacritty -e nmtui",
    },

    "battery": {
	"states": {
	    // "good": 95,
	    "warning": 15,
	    "critical": 10
	},
	"format": " {icon} {capacity}%",
	"format-charging": "{capacity}% ",
	"format-plugged": "{capacity}% ",
	"format-alt": "{time} {icon}",
	// "format-good": "", // An empty format will hide the module
	// "format-full": "",
	"format-icons": ["", "", "", "", ""]
    },

    "wireplumber": {
	"format": "{icon} {volume}%",
	"format-muted": "",
	"on-click": "pavucontrol",
	"format-icons": ["", "", ""],
	"format-muted": ""
    },

    "user": {
	"format": " {work_d}d",
	"interval": 60,
	"height": 30,
	"width": 30,
	"icon": false,
    },
    
    "privacy": {
	"icon-spacing": 4,
	"icon-size": 18,
	"transition-duration": 250
    },

    "idle_inhibitor": {
	"format": "{icon}",
	"format-icons": {
	    "activated": "",
	    "deactivated": ""
	}
    },

    "sway/workspaces": {
	"disable-scroll": true    
    },

    "sway/mode": {
	"format": "{}"
    },

    "sway/scratchpad": {
	"format": "{icon} {count}",
	"show-empty": false,
	"format-icons": ["", ""],
	"tooltip": true,
	"tooltip-format": "{app}: {title}"
    },

    // see also https://github.com/Alexays/Waybar/issues/1712#issuecomment-1803911617
    "sway/window": {
	"format": "{shell}@@{app_id}@@{title}",
	"rewrite": {
	    "@@@@": "", // in case no window is focused
	    "(xwayland)@@(.*)@@(.*)": "[X:$2] $3", // format app_id for X apps
	    "(xdg_shell)@@(.*)@@(.*)": "[$2] $3", // format app_id for wayland apps
	}
    },

}

